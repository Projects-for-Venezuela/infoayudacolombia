---
import { IconChevronRight, IconMenu2, IconPhone, IconX } from '@tabler/icons-astro'

import { navigation, emergency } from '~/widget/navbar/navbar'
---

<!-- Identidad de Colombia -->
<div class="h-1 w-full" aria-hidden="true">
  <div class="flex h-full">
    <span class="w-1/2 bg-colombia-yellow"></span>
    <span class="w-1/4 bg-colombia-blue"></span>
    <span class="w-1/4 bg-colombia-red"></span>
  </div>
</div>

<header class="sticky top-0 z-50 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-xl">
  <!-- Navbar principal -->
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex min-h-16 w-full items-center gap-3 lg:gap-6">
      <!-- Marca -->
      <a
        href="/"
        aria-label="Info Ayuda Colombia - Inicio"
        class="group flex shrink-0 items-center gap-2.5 no-underline"
      >
        <div
          class="relative flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-colombia-blue shadow-sm ring-1 ring-colombia-blue/10 transition-transform duration-200 group-hover:scale-105"
        >
          <img
            src="/favicon.ico"
            alt=""
            width="40"
            height="40"
            class="h-full w-full object-cover"
          />
        </div>

        <div class="hidden sm:block">
          <span class="block text-[15px] font-extrabold leading-none tracking-tight text-slate-900">
            Info Ayuda
          </span>

          <span
            class="mt-1 block text-[10px] font-bold uppercase tracking-[0.18em] text-colombia-blue"
          >
            Colombia
          </span>
        </div>
      </a>

      <!-- Separador -->
      <div class="hidden h-8 w-px bg-slate-200 lg:block" aria-hidden="true"></div>

      <!-- Navegación desktop -->
      <nav aria-label="Navegación principal" class="hidden min-w-0 flex-1 lg:block">
        <div class="flex w-full items-center justify-center gap-1">
          {
            navigation.map(({ label, href, icon: Icon }) => (
              <a
                href={href}
                class="group inline-flex items-center gap-2 rounded-xl px-3.5 py-2.5 text-[13px] font-semibold text-slate-600 no-underline transition-all duration-200 hover:bg-slate-50 hover:text-colombia-blue"
              >
                <Icon
                  size={17}
                  stroke={1.8}
                  aria-hidden="true"
                  class="shrink-0 transition-transform duration-200 group-hover:scale-105"
                />

                <span>{label}</span>
              </a>
            ))
          }
        </div>
      </nav>

      <!-- Acción principal -->
      <a
        href={emergency.href}
        class="hidden shrink-0 items-center gap-2 rounded-xl bg-colombia-red px-4 py-2.5 text-[13px] font-bold text-white no-underline shadow-sm shadow-colombia-red/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-red-dark hover:shadow-md lg:inline-flex"
      >
        <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/15">
          <IconPhone size={13} stroke={2.2} aria-hidden="true" />
        </span>

        <span>{emergency.label}</span>
      </a>

      <!-- Botón móvil -->
      <button
        id="mobileMenuButton"
        type="button"
        aria-label="Abrir menú"
        aria-controls="mobileMenu"
        aria-expanded="false"
        class="ml-auto flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-sm transition-all duration-200 hover:border-colombia-blue/30 hover:bg-slate-50 hover:text-colombia-blue lg:hidden"
      >
        <IconMenu2 id="menuOpenIcon" size={21} stroke={2} aria-hidden="true" />

        <IconX id="menuCloseIcon" size={21} stroke={2} aria-hidden="true" class="hidden" />
      </button>
    </div>
  </div>

  <!-- Menú móvil -->
  <div id="mobileMenu" class="hidden border-t border-slate-200 bg-white lg:hidden">
    <div class="w-full px-4 py-5 sm:px-6">
      <!-- Encabezado -->
      <div class="mb-4">
        <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-colombia-blue">
          Info Ayuda Colombia
        </p>

        <h2 class="mt-1 text-base font-bold tracking-tight text-slate-900">¿Qué necesitas?</h2>
      </div>

      <!-- Opciones -->
      <nav aria-label="Navegación móvil" class="grid gap-1.5">
        {
          navigation.map(({ label, href, icon: Icon, description }) => (
            <a
              href={href}
              class="group flex items-center gap-3 rounded-2xl border border-transparent px-3 py-3 no-underline transition-all duration-200 hover:border-slate-200 hover:bg-slate-50"
            >
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-colombia-blue transition-all duration-200 group-hover:bg-colombia-blue group-hover:text-white">
                <Icon size={20} stroke={1.8} aria-hidden="true" />
              </span>

              <span class="min-w-0 flex-1">
                <span class="block text-sm font-bold text-slate-900">{label}</span>

                <span class="mt-0.5 block truncate text-xs text-slate-500">{description}</span>
              </span>

              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-slate-400 transition-all duration-200 group-hover:bg-white group-hover:text-colombia-blue">
                <IconChevronRight size={17} stroke={1.8} aria-hidden="true" />
              </span>
            </a>
          ))
        }
      </nav>

      <!-- Emergencia -->
      <a
        href={emergency.href}
        class="mt-4 flex items-center gap-3 rounded-2xl bg-colombia-red p-3.5 text-white no-underline shadow-md shadow-colombia-red/15 transition-all duration-200 hover:bg-red-dark"
      >
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-white/15">
          <IconPhone size={21} stroke={2} aria-hidden="true" />
        </span>

        <span class="min-w-0 flex-1">
          <span class="block text-sm font-bold">
            {emergency.label}
          </span>

          <span class="mt-0.5 block text-xs text-white/80">
            {emergency.description}
          </span>
        </span>

        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/10">
          <IconChevronRight size={18} stroke={2} aria-hidden="true" />
        </span>
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('#mobileMenuButton')

  const menu = document.querySelector<HTMLElement>('#mobileMenu')

  const openIcon = document.querySelector<SVGElement>('#menuOpenIcon')

  const closeIcon = document.querySelector<SVGElement>('#menuCloseIcon')

  const closeMenu = () => {
    menu?.classList.add('hidden')
    openIcon?.classList.remove('hidden')
    closeIcon?.classList.add('hidden')

    button?.setAttribute('aria-expanded', 'false')
    button?.setAttribute('aria-label', 'Abrir menú')
  }

  button?.addEventListener('click', () => {
    if (!menu) return

    const isOpen = !menu.classList.contains('hidden')

    menu.classList.toggle('hidden', isOpen)
    openIcon?.classList.toggle('hidden', !isOpen)
    closeIcon?.classList.toggle('hidden', isOpen)

    button.setAttribute('aria-expanded', String(!isOpen))

    button.setAttribute('aria-label', isOpen ? 'Abrir menú' : 'Cerrar menú')
  })

  document.querySelectorAll<HTMLAnchorElement>('#mobileMenu a').forEach(link => {
    link.addEventListener('click', closeMenu)
  })

  document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
      closeMenu()
    }
  })

  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMenu()
    }
  })
</script>
