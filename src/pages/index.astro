---
import Layout from '~/layouts/Layout.astro'

import StatsRow from '~/features/home/ui/StatsRow.astro'
import DepartmentCenters from '~/features/home/ui/DepartmentCenters.astro'
import Hero from '~/features/home/ui/Hero.astro'
import EarthquakeAlert from '~/widget/earthquake/EarthquakeAlert.astro'
import Supplies from '~/features/home/ui/Supplies.astro'
import Emergency from '~/features/home/ui/Emergency.astro'
---

<Layout
  title="Inicio"
  description="Directorio de centros de acopio verificados en Colombia. Encuentra dónde donar agua,
alimentos, medicinas e insumos para los afectados por el sismo del 10 de agosto de 2026. Cobertura
nacional e internacional."
  canonical="https://infoayudacolombia.vercel.app/"
>
  <Hero />
  <main class="w-full">
    <div
      class="mx-auto flex w-full max-w-7xl flex-col gap-5 px-3 py-5 xs:px-4 sm:gap-6 sm:px-6 sm:py-7 md:px-8 md:py-8 lg:px-10 lg:py-10 xl:px-12"
    >
      <EarthquakeAlert />
      <StatsRow totalCentros={24} totalEstados={8} totalCiudades={8} />
      <DepartmentCenters />
      <Supplies />
      <Emergency />
    </div>
  </main>
</Layout>
