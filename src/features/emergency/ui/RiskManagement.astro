---
import { IconBuildingBank, IconPhone } from '@tabler/icons-astro'

import { emergencyInstitutions } from '~/data/emergency'
---

<section class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-widest text-colombia-blue">
        Gestión del riesgo
      </p>

      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
        Información institucional
      </h2>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        Canales de contacto para información y gestión del riesgo de desastres.
      </p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        emergencyInstitutions.map(institution => (
          <a
            href={institution.href}
            class="group flex gap-4 rounded-2xl border border-slate-200 bg-white p-5 transition hover:border-colombia-blue/30 hover:shadow-sm"
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-colombia-blue/10 text-colombia-blue">
              <IconBuildingBank size={21} stroke={1.8} />
            </div>

            <div class="min-w-0">
              <h3 class="text-sm font-black text-slate-950">{institution.name}</h3>

              <div class="mt-2 flex items-center gap-2 text-sm font-bold text-colombia-blue">
                <IconPhone size={16} stroke={2} />

                {institution.number}
              </div>

              <p class="mt-1 text-xs leading-5 text-slate-500">{institution.description}</p>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
