---
import { IconArrowUpRight, IconMapPin } from '@tabler/icons-astro'

import type { EmergencyCity } from '~/data/emergency'

interface Props {
  cities: EmergencyCity[]
}

const { cities } = Astro.props
---

<section class="bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-widest text-colombia-blue">Atención local</p>

      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
        Líneas de emergencia por ciudad
      </h2>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        Consulta los números de emergencia disponibles en las ciudades incluidas en esta
        información.
      </p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {
        cities.map(city => (
          <article class="overflow-hidden rounded-2xl border border-slate-200 bg-slate-50">
            <div class="border-b border-slate-200 bg-white p-5">
              <div class="flex items-start justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <IconMapPin size={18} stroke={2} class="text-colombia-blue" />

                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">
                      {city.department}
                    </span>
                  </div>

                  <h3 class="mt-2 text-2xl font-black tracking-tight text-slate-950">
                    {city.city}
                  </h3>
                </div>

                <span
                  class:list={[
                    'h-3 w-3 shrink-0 rounded-full',
                    city.accent === 'yellow' && 'bg-yellow-400',
                    city.accent === 'red' && 'bg-red-500',
                    city.accent === 'purple' && 'bg-purple-500',
                    city.accent === 'blue' && 'bg-blue-500',
                    city.accent === 'green' && 'bg-emerald-500',
                  ]}
                />
              </div>
            </div>

            <div class="space-y-2 p-4">
              {city.contacts.map(contact => {
                const Icon = contact.icon

                return (
                  <a
                    href={contact.href}
                    class:list={[
                      'group flex items-center gap-4 rounded-xl border p-3 transition',
                      contact.featured
                        ? 'border-colombia-blue/20 bg-colombia-blue/5'
                        : 'border-slate-200 bg-white hover:border-colombia-blue/30',
                    ]}
                  >
                    <div
                      class:list={[
                        'flex h-10 w-10 shrink-0 items-center justify-center rounded-lg',
                        contact.featured
                          ? 'bg-colombia-blue text-white'
                          : 'bg-slate-100 text-slate-500 group-hover:bg-colombia-blue/10 group-hover:text-colombia-blue',
                      ]}
                    >
                      <Icon size={19} stroke={1.8} />
                    </div>

                    <div class="min-w-0 flex-1">
                      <p class="text-base font-black tracking-tight text-slate-950">
                        {contact.number}
                      </p>

                      <p class="text-xs leading-5 text-slate-500">{contact.name}</p>
                    </div>

                    <IconArrowUpRight
                      size={17}
                      stroke={1.8}
                      class="shrink-0 text-slate-300 transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-colombia-blue"
                    />
                  </a>
                )
              })}
            </div>

            {city.note && (
              <div class="border-t border-slate-200 bg-white px-5 py-4">
                <p class="text-xs leading-5 text-slate-500">
                  <span class="font-black text-slate-700">Ten en cuenta:</span> {city.note}
                </p>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
