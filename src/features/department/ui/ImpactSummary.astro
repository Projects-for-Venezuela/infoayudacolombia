---
import {
  IconHeartHandshake,
  IconHome,
  IconMedicalCross,
  IconUsers,
  IconExternalLink,
} from '@tabler/icons-astro'

interface Source {
  name: string
  url: string
  type: 'official' | 'media' | 'institutional'
  publishedAt?: string
  updatedAt?: string
}

interface Fact {
  value: string
  source?: Source
  updatedAt?: string
}

interface Department {
  affectedPeople: Fact
  deaths: Fact
  injured: Fact
  homes: Fact
}

interface Props {
  department: Department
}

const { department } = Astro.props

const stats = [
  {
    label: 'Personas afectadas',
    fact: department.affectedPeople,
    category: 'Afectación',
    icon: IconUsers,
    iconClass: 'bg-colombia-blue/10 text-colombia-blue',
  },
  {
    label: 'Fallecidos',
    fact: department.deaths,
    category: 'Balance',
    icon: IconHeartHandshake,
    iconClass: 'bg-red-50 text-colombia-red',
  },
  {
    label: 'Heridos',
    fact: department.injured,
    category: 'Atención',
    icon: IconMedicalCross,
    iconClass: 'bg-red-50 text-colombia-red',
  },
  {
    label: 'Viviendas',
    fact: department.homes,
    category: 'Infraestructura',
    icon: IconHome,
    iconClass: 'bg-yellow-50 text-[#9A7500]',
  },
]
---

<section class="mx-auto max-w-7xl px-4 py-7 sm:px-6 sm:py-9 lg:px-8">
  <!-- Section header -->
  <div class="mb-5">
    <p
      class="text-xs font-bold uppercase tracking-widest text-colombia-blue"
    >
      Situación actual
    </p>

    <h2
      class="mt-1 text-2xl font-black tracking-tight text-slate-950"
    >
      Resumen de afectación
    </h2>
  </div>

  <!-- Statistics -->
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {
      stats.map((stat) => {
        const Icon = stat.icon

        return (
          <article
            class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
          >
            <!-- Top -->
            <div class="flex items-center justify-between">
              <div
                class:list={[
                  'flex h-10 w-10 items-center justify-center rounded-xl',
                  stat.iconClass,
                ]}
              >
                <Icon size={21} />
              </div>

              <span
                class="text-[10px] font-bold uppercase tracking-wider text-slate-400"
              >
                {stat.category}
              </span>
            </div>

            <!-- Label -->
            <p
              class="mt-5 text-xs font-bold uppercase tracking-wide text-slate-400"
            >
              {stat.label}
            </p>

            <!-- Value -->
            <p
              class="mt-1 text-xl font-black leading-tight text-slate-950"
            >
              {stat.fact.value}
            </p>

            <!-- Source -->
            {
              stat.fact.source && (
                <div class="mt-3 border-t border-slate-100 pt-3">
                  <div class="flex items-center gap-1.5">
                    <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">
                      Fuente
                    </span>

                    <span class="h-1 w-1 rounded-full bg-slate-300"></span>

                    <a
                      href={stat.fact.source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-w-0 items-center gap-1 text-[11px] font-bold text-colombia-blue hover:underline"
                    >
                      <span class="truncate">
                        {stat.fact.source.name}
                      </span>

                      <IconExternalLink
                        size={12}
                        class="shrink-0"
                      />
                    </a>
                  </div>

                  {
                    stat.fact.updatedAt && (
                      <p class="mt-1 text-[10px] text-slate-400">
                        Actualizado: {stat.fact.updatedAt}
                      </p>
                    )
                  }
                </div>
              )
            }
          </article>
        )
      })
    }
  </div>
</section>

