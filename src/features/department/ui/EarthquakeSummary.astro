---
interface Source {
  name: string
  url: string
  type: 'official' | 'media' | 'institutional'
  publishedAt?: string
  updatedAt?: string
}

interface Fact {
  value: string
  source?: Source
  updatedAt?: string
}

interface Earthquake {
  title: string
  magnitude: string | number
  date: string
  time: string
  epicenter: string
  depth: string
  status: string
}

interface Department {
  summary: Fact
}

interface Props {
  department: Department
  earthquake: Earthquake
}

const { department, earthquake } = Astro.props
---

<section class="relative overflow-hidden bg-colombia-blue text-white">
  <!-- Decorative background -->
  <div class="pointer-events-none absolute inset-0 opacity-10">
    <div class="absolute -right-32 -top-32 h-80 w-80 rounded-full border-[40px] border-white"></div>

    <div class="absolute -bottom-48 -left-24 h-96 w-96 rounded-full border-[50px] border-white">
    </div>
  </div>

  <div class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-10 lg:px-8 lg:py-12">
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_220px] lg:items-center">
      <!-- Information -->
      <div>
        <div
          class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-white/60"
        >
          <span class="h-2 w-2 rounded-full bg-colombia-yellow" aria-hidden="true"></span>

          Emergencia sísmica
        </div>

        <h2 class="mt-3 max-w-3xl text-2xl font-black tracking-tight sm:text-4xl">
          {earthquake.title}
        </h2>

        <p class="mt-4 max-w-3xl text-sm leading-7 text-white/75 sm:text-base">
          {department.summary.value}
        </p>

        {
          department.summary.source && (
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs">
              {/* <span class="font-semibold text-white/50">Fuente:</span>

              <a
                href={department.summary.source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold text-white underline decoration-white/30 underline-offset-4 transition hover:decoration-white"
              >
                {department.summary.source.name}
              </a> */}

              {department.summary.source.publishedAt && (
                <>
                  <span class="text-white/30">•</span>

                  <span class="text-white/50">
                    Publicado: {department.summary.source.publishedAt}
                  </span>
                </>
              )}
            </div>
          )
        }
      </div>

      <!-- Magnitude -->
      <div
        class="rounded-3xl border border-white/10 bg-white/10 p-6 text-center shadow-xl backdrop-blur"
      >
        <p class="text-xs font-bold uppercase tracking-widest text-white/60">Magnitud</p>

        <p class="mt-1 text-6xl font-black tracking-tight sm:text-7xl">
          {earthquake.magnitude}
        </p>

        <p class="mt-1 text-xs font-semibold text-white/60">Magnitud reportada</p>
      </div>
    </div>

    <!-- Earthquake data -->
    <div class="mt-8 grid gap-2 sm:grid-cols-2 lg:grid-cols-5">
      {
        [
          ['Fecha', earthquake.date],
          ['Hora', earthquake.time],
          ['Epicentro', earthquake.epicenter],
          ['Profundidad', earthquake.depth],
          ['Estado', earthquake.status],
        ].map(([label, value]) => (
          <div class="rounded-2xl border border-white/10 bg-white/10 p-4">
            <p class="text-[11px] font-bold uppercase tracking-wider text-white/50">{label}</p>

            <p class="mt-1 text-sm font-bold">{value}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
