---
import { IconArrowRight } from '@tabler/icons-astro'

import { categories } from '~/data/supplies'
---

<section class="w-full">
  <div class="mx-auto max-w-7xl px-3 py-8 sm:px-6 sm:py-10 lg:px-8">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-colombia-blue">
          Ayuda disponible
        </p>

        <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
          Insumos necesarios
        </h2>

        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          Consulta los principales insumos que pueden ser solicitados por los centros de acopio.
        </p>
      </div>

      <a
        href="/supplies"
        class="hidden shrink-0 items-center gap-1.5 text-sm font-bold text-colombia-blue transition-colors hover:text-colombia-blue-dark sm:flex"
      >
        Ver todos
        <IconArrowRight size={17} stroke={2} />
      </a>
    </div>

    <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(category => {
          const Icon = category.icon

          return (
            <a
              href="/supplies"
              class="group flex items-center gap-4 rounded-2xl border border-slate-200 bg-white p-4 transition-all duration-200 hover:border-colombia-blue/30 hover:shadow-sm"
            >
              <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-colombia-blue/10 text-colombia-blue">
                <Icon size={21} stroke={1.8} />
              </div>

              <div class="min-w-0 flex-1">
                <h3 class="text-sm font-black text-slate-950">{category.title}</h3>

                <p class="mt-0.5 text-xs text-slate-500">{category.supplies.length} insumos</p>
              </div>

              <IconArrowRight
                size={17}
                stroke={1.8}
                class="shrink-0 text-slate-300 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:text-colombia-blue"
              />
            </a>
          )
        })
      }
    </div>

    <a
      href="/supplies"
      class="mt-4 flex items-center justify-center gap-1.5 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-bold text-colombia-blue sm:hidden"
    >
      Ver todos los insumos
      <IconArrowRight size={17} stroke={2} />
    </a>
  </div>
</section>
