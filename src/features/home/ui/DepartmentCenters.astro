---
import { IconArrowUpRight, IconMapPin } from '@tabler/icons-astro'
import { Image } from 'astro:assets'

import Antioquia from '~/assets/flags/Antioquia.webp'
import Bogota from '~/assets/flags/Bogota.webp'
import Bolivar from '~/assets/flags/Bolivar.webp'
import Caldas from '~/assets/flags/Caldas.webp'
import Quindio from '~/assets/flags/Quindio.webp'
import Risaralda from '~/assets/flags/Risaralda.webp'
import Tolima from '~/assets/flags/Tolima.webp'
import ValleDelCauca from '~/assets/flags/Valle_del_Cauca.webp'

interface Department {
  name: string
  centers: number
  cities: string
  status?: 'urgent' | 'progress' | 'covered'
  slug: string
  image: ImageMetadata
}

const departments: Department[] = [
  {
    name: 'Risaralda',
    centers: 7,
    cities: 'Pereira',
    status: 'urgent',
    slug: 'Risaralda',
    image: Risaralda,
  },
  {
    name: 'Antioquia',
    centers: 10,
    cities: 'Medellín',
    status: 'covered',
    slug: 'Antioquia',
    image: Antioquia,
  },
  {
    name: 'Bogotá D. C.',
    centers: 4,
    cities: 'Bogotá',
    status: 'covered',
    slug: 'Bogota',
    image: Bogota,
  },
  {
    name: 'Valle del Cauca',
    centers: 1,
    cities: 'Cali',
    status: 'urgent',
    slug: 'Valle_del_Cauca',
    image: ValleDelCauca,
  },
  {
    name: 'Caldas',
    centers: 1,
    cities: 'Manizales',
    status: 'urgent',
    slug: 'Caldas',
    image: Caldas,
  },
  {
    name: 'Quindío',
    centers: 1,
    cities: 'Armenia',
    status: 'urgent',
    slug: 'Quindío',
    image: Quindio,
  },
  {
    name: 'Bolívar',
    centers: 1,
    cities: 'Cartagena',
    status: 'covered',
    slug: 'Bolivar',
    image: Bolivar,
  },
  {
    name: 'Tolima',
    centers: 1,
    cities: 'Ibagué',
    status: 'covered',
    slug: 'Tolima',
    image: Tolima,
  },
]

const statusConfig = {
  urgent: {
    label: 'Requiere ayuda urgente',
    className: 'bg-colombia-red/10 text-colombia-red',
  },
  progress: {
    label: 'Ayuda en camino',
    className: 'bg-colombia-yellow/15 text-[#8A6800]',
  },
  covered: {
    label: 'Centro habilitado',
    className: 'bg-green-100 text-green-700',
  },
}
---

<section
  id="gridTitle"
  aria-labelledby="departments-title"
  class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
>
  <div class="mb-6">
    <h2 id="departments-title" class="text-2xl font-extrabold tracking-tight text-text sm:text-3xl">
      Departamentos con centros de acopio
    </h2>

    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-muted sm:text-base">
      Encuentra puntos de recepción de ayudas habilitados para apoyar a las comunidades afectadas
      por el sismo.
    </p>
  </div>

  <div
    class="mb-6 flex gap-2 overflow-x-auto pb-1"
    role="tablist"
    aria-label="Filtrar departamentos"
  >
    <button
      type="button"
      class="shrink-0 rounded-full bg-colombia-blue px-4 py-2 text-xs font-bold text-white"
    >
      Todas las zonas
    </button>

    <button
      type="button"
      class="shrink-0 rounded-full border border-border bg-white px-4 py-2 text-xs font-bold text-muted transition-colors hover:border-colombia-red/30 hover:text-colombia-red"
    >
      Requiere ayuda urgente
    </button>

    <button
      type="button"
      class="shrink-0 rounded-full border border-border bg-white px-4 py-2 text-xs font-bold text-muted transition-colors hover:border-colombia-yellow/40 hover:text-[#8A6800]"
    >
      Ayuda en camino
    </button>

    <button
      type="button"
      class="shrink-0 rounded-full border border-border bg-white px-4 py-2 text-xs font-bold text-muted transition-colors hover:border-green-200 hover:text-green-700"
    >
      Centro habilitado
    </button>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {
      departments.map(department => (
        <a
          href={`/state/${department.slug}`}
          class="group relative overflow-hidden rounded-2xl border border-border bg-white no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-colombia-blue/30 hover:shadow-md"
        >
          <div class="relative h-28 overflow-hidden sm:h-32">
            <Image
              src={department.image}
              alt={`Bandera de ${department.name}`}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              width={600}
              height={200}
              loading="lazy"
            />

            <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent" />

            <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between gap-3">
              <h3 class="truncate text-lg font-extrabold text-white sm:text-xl">
                {department.name}
              </h3>

              <span class="shrink-0 rounded-full bg-white/90 px-2.5 py-1 text-xs font-extrabold text-colombia-blue backdrop-blur-sm">
                {department.centers}
              </span>
            </div>
          </div>

          <div class="p-4 sm:p-5">
            <div class="flex items-center gap-1.5 text-xs text-muted">
              <IconMapPin size={14} stroke={2} aria-hidden="true" />

              <span class="truncate">{department.cities}</span>
            </div>

            <div class="mt-4 flex items-center justify-between gap-3">
              {department.status ? (
                <span
                  class:list={[
                    'rounded-full px-2.5 py-1 text-[10px] font-bold',
                    statusConfig[department.status].className,
                  ]}
                >
                  {statusConfig[department.status].label}
                </span>
              ) : (
                <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">
                  {department.centers} centros de acopio
                </span>
              )}

              <IconArrowUpRight
                size={17}
                stroke={2}
                class="shrink-0 text-muted transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-colombia-blue"
                aria-hidden="true"
              />
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
