---
import type { Category } from '~/data/supplies'
import { IconArrowUpRight } from '@tabler/icons-astro'

interface Props {
  categories: Category[]
}

const { categories } = Astro.props
---

<section class="bg-slate-50">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16 lg:px-8">
    <div class="mb-8 max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-widest text-colombia-blue">Qué puedes donar</p>

      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
        Categorías de insumos
      </h2>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        Consulta las categorías y verifica siempre las necesidades actuales antes de realizar una
        donación.
      </p>
    </div>

    <div class="grid gap-4 md:grid-cols-2">
      {
        categories.map(category => {
          const Icon = category.icon

          return (
            <article class="group overflow-hidden rounded-2xl border border-slate-200 bg-white transition-all duration-200 hover:border-colombia-blue/30 hover:shadow-md">
              <header class="p-5 sm:p-6">
                <div class="flex items-start gap-4">
                  <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-colombia-blue/10 text-colombia-blue">
                    <Icon size={22} stroke={1.8} />
                  </div>

                  <div class="min-w-0 flex-1">
                    <div class="flex items-start justify-between gap-3">
                      <h3 class="text-base font-black text-slate-950 sm:text-lg">
                        {category.title}
                      </h3>

                      <IconArrowUpRight
                        size={18}
                        stroke={1.8}
                        class="mt-0.5 shrink-0 text-slate-300 transition-colors group-hover:text-colombia-blue"
                      />
                    </div>

                    <p class="mt-1 text-sm leading-6 text-slate-500">{category.description}</p>
                  </div>
                </div>
              </header>

              <div class="border-t border-slate-100">
                {category.supplies.map((supply, index) => (
                  <div
                    class:list={[
                      'px-5 py-4 sm:px-6',
                      index !== category.supplies.length - 1 && 'border-b border-slate-100',
                    ]}
                  >
                    <div class="flex items-start justify-between gap-3">
                      <h4 class="text-sm font-bold text-slate-900">{supply.name}</h4>

                      {supply.priority === 'high' && (
                        <span class="shrink-0 rounded-full bg-red-50 px-2 py-1 text-[10px] font-bold uppercase tracking-wide text-red-700">
                          Prioridad
                        </span>
                      )}
                    </div>

                    <p class="mt-1 text-sm leading-6 text-slate-500">{supply.description}</p>
                  </div>
                ))}
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>
