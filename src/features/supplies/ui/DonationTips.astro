---
import { IconCircleCheck } from '@tabler/icons-astro'

interface Props {
  tips: string[]
}

const { tips } = Astro.props
---

<section class="border-t border-slate-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-14 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-widest text-colombia-blue">Recomendaciones</p>

      <h2 class="mt-2 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">
        Consejos para donar
      </h2>

      <p class="mt-3 text-sm leading-6 text-slate-500">
        Una donación organizada facilita la recepción, clasificación y distribución de los recursos.
      </p>
    </div>

    <div class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        tips.map(tip => (
          <article class="flex gap-3 rounded-xl border border-slate-200 p-4">
            <IconCircleCheck size={20} stroke={1.8} class="mt-0.5 shrink-0 text-colombia-blue" />

            <p class="text-sm leading-6 text-slate-600">{tip}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
